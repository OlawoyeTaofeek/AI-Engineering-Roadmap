# Git LFS tracking for large binary artifacts.
# Run `git lfs install` once, then `git lfs track` is already configured below --
# just `git add .gitattributes` and commit as usual.

*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
